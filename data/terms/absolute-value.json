  "spoken_en": "the absolute value of x",
  "examples": [
    {
      "en": "The absolute value of negative 6 is 6, because negative 6 is 6 units away from zero.",
      "ja": "−6 の絶対値は 6。0 から 6 目盛り離れているからね。",
      "register": "spoken"
    },
    {
      "en": "Find the absolute value of each number: −12, 3/4, 0.",
