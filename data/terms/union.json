  "spoken_en": "A union B",
  "examples": [
    {
      "en": "A union B means anything that's in A or in B, or in both.",
      "ja": "A 和集合 B は、A か B の少なくとも一方に入っているもの全部だ。",
      "register": "spoken"
    },
    {
      "en": "Let A = {1, 3, 5} and B = {3, 4}. Find the union of A and B.",
      "ja": "A = {1, 3, 5}、B = {3, 4} のとき、A と B の和集合を求めよ。",
