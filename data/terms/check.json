  "spoken_en": null,
  "examples": [
    {
      "en": "Let's check: 2 times 4 plus 3 is 11, so x = 4 works.",
      "ja": "確かめよう。2 × 4 + 3 = 11 だから、x = 4 で合っているね。",
      "register": "spoken"
    },
    {
