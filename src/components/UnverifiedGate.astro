---
/**
 * Detail pages of entries that have not passed the audit. With the toggle off
 * (the default in a build) the body stays hidden and this note says why
 * (DECISIONS, Phase 0: likely is an off-by-default toggle, not deleted).
 */
interface Props {
  kind?: string;
}
const { kind = "項目" } = Astro.props;
---

<div class="gate" data-when-hidden>
  <p>
    この{kind}はまだ監査を通っていません（<strong>未確認</strong>）。日英の対応や例文が米国の教室の言い方と合っているか、確認中です。
  </p>
  <button type="button" data-show-unverified>未確認の内容を表示する</button>
</div>
