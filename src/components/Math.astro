---
import "katex/dist/katex.min.css";
import katex from "katex";

interface Props {
  latex: string;
  display?: boolean;
}
const { latex, display = true } = Astro.props;
const html = katex.renderToString(latex, { displayMode: display, throwOnError: false });
---

<span class={display ? "math math-display" : "math"} set:html={html} />
