---
interface Props {
  text: string;
  label?: string;
}
const { text, label = "音声で聞く" } = Astro.props;
---

<button type="button" class="speak" data-text={text} aria-label={`英語の音声: ${text}`} hidden>
  <span aria-hidden="true">🔊</span>{label && <span>&nbsp;{label}</span>}
</button>

<script>
  // Web Speech API (PLAN 7). If the device has no English voice the buttons stay hidden.
  const synth = window.speechSynthesis;
  if (synth) {
    const reveal = () => {
      const hasEn = synth.getVoices().some((v) => v.lang.toLowerCase().startsWith("en"));
      if (!hasEn) return;
      document.querySelectorAll<HTMLButtonElement>("button.speak").forEach((b) => (b.hidden = false));
    };
    reveal();
    synth.addEventListener?.("voiceschanged", reveal);

    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement)?.closest("button.speak") as HTMLButtonElement | null;
      if (!btn) return;
      synth.cancel();
      const u = new SpeechSynthesisUtterance(btn.dataset.text ?? "");
      u.lang = "en-US";
      const voice = synth.getVoices().find((v) => v.lang === "en-US");
      if (voice) u.voice = voice;
      u.rate = 0.92;
      synth.speak(u);
    });
  }
</script>
