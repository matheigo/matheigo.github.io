---
import Base from "../layouts/Base.astro";
import { curriculum, termById } from "../lib/data";

const jp = curriculum.filter((c) => c.system === "jp");
const us = curriculum.filter((c) => c.system === "us");
const COVERAGE: Record<string, string> = { full: "ほぼ一致", most: "大部分", some: "一部", none: "対応なし" };
---

<Base title="カリキュラム対応表 — MathEigo" description="日本の数学I〜数学C と、米国の Algebra 1〜Calculus III の対応。">
  <h1 class="term-ja" style="font-size:var(--step-2)">カリキュラム対応表</h1>
  <p>「数IIIの内容は Calc I なのか BC なのか」を単元ごとに引くための表です。Phase 1 で全単元に広げます。</p>

  <h2 style="font-size:var(--step-1);margin-top:2rem">日本の単元から引く</h2>
  {jp.map((u) => (
    <section class="block" id={u.id}>
      <h2>{u.subject} — {u.unit}</h2>
      <p>{u.topics.join("・")}</p>
      <table class="grid">
        <thead><tr><th>米国の科目</th><th>対応</th><th>注記</th></tr></thead>
        <tbody>
          {(u.us_equivalents ?? []).map((e) => (
            <tr><td>{e.course}</td><td>{COVERAGE[e.coverage] ?? e.coverage}</td><td>{e.note ?? ""}</td></tr>
          ))}
        </tbody>
      </table>
      {u.term_refs.length ? (
        <p class="meta">{u.term_refs.map((r) => termById.has(r) ? <a href={`/terms/${r}`}>{termById.get(r)!.ja.term} </a> : null)}</p>
      ) : null}
    </section>
  ))}

  <h2 style="font-size:var(--step-1);margin-top:2rem">米国の科目から引く</h2>
  {us.map((u) => (
    <section class="block" id={u.id}>
      <h2>{u.subject} — {u.unit}</h2>
      <p>{u.topics.join(" ・ ")}</p>
      <table class="grid">
        <thead><tr><th>日本の科目</th><th>対応</th><th>注記</th></tr></thead>
        <tbody>
          {(u.jp_equivalents ?? []).map((e) => (
            <tr><td>{e.subject}</td><td>{COVERAGE[e.coverage] ?? e.coverage}</td><td>{e.note ?? ""}</td></tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
</Base>
