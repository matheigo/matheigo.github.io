---
import Base from "../../layouts/Base.astro";
import Sources from "../../components/Sources.astro";
import Report from "../../components/Report.astro";
import UnverifiedGate from "../../components/UnverifiedGate.astro";
import {
  conventions,
  termById,
  symbolById,
  conventionById,
  isUnverified,
  isExplanatoryTranslation,
  CONVENTION_CATEGORY_LABELS,
  SITE_NAME,
  levelJp,
  levelUs,
} from "../../lib/data";
import { GLOSS_LABEL, GLOSS_SHORT } from "../../lib/gloss";
import { ogPath } from "../../lib/og";

export function getStaticPaths() {
  return conventions.map((c) => ({ params: { id: c.id }, props: { convention: c } }));
}

const { convention: c } = Astro.props;
const unverified = isUnverified(c);
const path = `/conventions/${c.id}/`;
const terms = (c.term_refs ?? []).map((r) => termById.get(r)).filter((t) => t !== undefined);
const related = (c.related ?? [])
  .map((r) => symbolById.get(r) ?? conventionById.get(r))
  .filter((x) => x !== undefined);
const category = CONVENTION_CATEGORY_LABELS[c.category] ?? c.category;
const jpLevel = levelJp(c.level);
const usLevel = levelUs(c.level);
---

<Base
  title={`${c.title_ja}（日米の違い）— ${SITE_NAME}`}
  description={`${c.advice_ja} 日本: ${c.jp}`}
  unverified={unverified}
  ogImage={ogPath("conventions", c.id, !unverified)}
  section="conventions"
>
  {unverified && <UnverifiedGate kind="慣習差" />}

  <article class="entry" data-unverified-item={unverified ? "" : undefined}>
    <header class="entry-head">
      {unverified && <p class="unverified-note">この項目はまだ監査を通っていません（未確認）。</p>}
      <p class="crumbs">
        <a href="/conventions/">日米の慣習差</a> ／ <a href={`/conventions/#${c.category}`}>{category}</a>
      </p>
      <h1 class="sym-ja">{c.title_ja}</h1>
      <p class="sym-en" lang="en">{c.title_en}</p>
      <p class="advice">{c.advice_ja}</p>
    </header>

    <div class="entry-body">
      <div class="entry-main">
        <div class="compare">
          <section>
            <h2>日本</h2>
            <p>{c.jp}</p>
          </section>
          <section>
            <h2>米国</h2>
            <p>{c.us}</p>
          </section>
        </div>
      </div>

      <aside class="entry-aside" aria-label="この項目について">
        <section class="first">
          <h2>習う時期</h2>
          <dl class="when">
            <dt>日本</dt>
            <dd>{jpLevel || "—"}</dd>
            <dt>米国</dt>
            <dd>{usLevel ? <span class="lat" lang="en">{usLevel}</span> : "—"}</dd>
          </dl>
        </section>

        {
          terms.length ? (
            <section>
              <h2>関係する用語</h2>
              <ul class="rel">
                {terms.map((t) => (
                  <li data-unverified-item={isUnverified(t) ? "" : undefined}>
                    <a href={`/terms/${t.id}/`}>
                      <span class="rel-ja">{t.ja.term}</span>
                      <span class="rel-en" lang="en">
                        {t.en.term}
                        {isExplanatoryTranslation(t) && (
                          <span class="gloss-short" lang="ja" title={GLOSS_LABEL}>
                            {GLOSS_SHORT}
                          </span>
                        )}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ) : null
        }

        {
          related.length ? (
            <section>
              <h2>関連する記号・慣習差</h2>
              <ul class="rel">
                {related.map((r) =>
                  "latex" in r ? (
                    <li>
                      <a href={`/symbols/${r.id}/`}>
                        <span class="rel-ja">{r.name_ja}</span>
                        <span class="rel-en" lang="en">
                          {r.spoken_en[0].text}
                        </span>
                      </a>
                    </li>
                  ) : (
                    <li>
                      <a href={`/conventions/${r.id}/`}>
                        <span class="rel-ja">{r.title_ja}</span>
                        <span class="rel-en" lang="en">
                          {r.title_en}
                        </span>
                      </a>
                    </li>
                  ),
                )}
              </ul>
            </section>
          ) : null
        }

        <section>
          <h2>出典</h2>
          <Sources sources={c.sources} />
        </section>

        <section class="about-entry">
          <h2>この項目について</h2>
          <p>
            {c.confidence === "verified" ? "監査済み" : "未確認（監査前）"}。分類は{category}。{c.updated && `更新 ${c.updated}。`}
          </p>
          <Report id={c.id} path={path} />
        </section>
      </aside>
    </div>
  </article>
</Base>
