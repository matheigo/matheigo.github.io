---
import Base from "../../layouts/Base.astro";
import En from "../../components/En.astro";
import Sources from "../../components/Sources.astro";
import Report from "../../components/Report.astro";
import UnverifiedGate from "../../components/UnverifiedGate.astro";
import {
  conventions,
  termById,
  symbolById,
  conventionById,
  isUnverified,
  isExplanatoryTranslation,
  CONVENTION_CATEGORY_LABELS,
  SITE_NAME,
  levelText,
} from "../../lib/data";
import { ogPath } from "../../lib/og";

export function getStaticPaths() {
  return conventions.map((c) => ({ params: { id: c.id }, props: { convention: c } }));
}

const { convention: c } = Astro.props;
const unverified = isUnverified(c);
const path = `/conventions/${c.id}/`;
const terms = (c.term_refs ?? []).map((r) => termById.get(r)).filter((t) => t !== undefined);
const related = (c.related ?? [])
  .map((r) => symbolById.get(r) ?? conventionById.get(r))
  .filter((x) => x !== undefined);
const category = CONVENTION_CATEGORY_LABELS[c.category] ?? c.category;
---

<Base
  title={`${c.title_ja}（日米の違い）— ${SITE_NAME}`}
  description={`${c.advice_ja} 日本: ${c.jp}`}
  unverified={unverified}
  ogImage={ogPath("conventions", c.id, !unverified)}
  section="conventions"
>
  {unverified && <UnverifiedGate kind="慣習差" />}

  <article class="entry" data-unverified-item={unverified ? "" : undefined}>
    {unverified && <p class="unverified-note">この項目はまだ監査を通っていません（未確認）。</p>}
    <header class="term-head">
      <p class="meta">
        <a href="/conventions/">日米の慣習差</a> ／ <a href={`/conventions/#${c.category}`}>{category}</a>
      </p>
      <h1 class="term-ja">{c.title_ja}</h1>
      <p class="term-en" lang="en">{c.title_en}</p>
    </header>

    <p class="advice">{c.advice_ja}</p>

    <div class="compare">
      <div>
        <h2>日本</h2>
        <p>{c.jp}</p>
      </div>
      <div>
        <h2>米国</h2>
        <p>{c.us}</p>
      </div>
    </div>

    {
      related.length ? (
        <section class="block">
          <h2>関連する記号・慣習差</h2>
          <ul class="links">
            {related.map((r) =>
              "latex" in r ? (
                <li>
                  <a href={`/symbols/${r.id}/`}>{r.name_ja}</a>
                  <span class="detail" lang="en">
                    {r.spoken_en[0].text}
                  </span>
                </li>
              ) : (
                <li>
                  <a href={`/conventions/${r.id}/`}>{r.title_ja}</a>
                  <span class="detail">{r.advice_ja}</span>
                </li>
              ),
            )}
          </ul>
        </section>
      ) : null
    }

    {
      terms.length ? (
        <section class="block">
          <h2>関係する用語</h2>
          <ul class="links">
            {terms.map((t) => (
              <li>
                <a href={`/terms/${t.id}/`}>{t.ja.term}</a>
                <En text={t.en.term} gloss={isExplanatoryTranslation(t)} class="detail" />
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    <section class="block meta">
      <h2>出典</h2>
      <Sources sources={c.sources} />
      <ul class="facts">
        <li>範囲: {levelText(c.level)}</li>
        <li>分類: {category}</li>
        <li>確認の段階: {c.confidence === "verified" ? "監査済み" : "未確認（監査前）"}</li>
        {c.updated && <li>更新: {c.updated}</li>}
      </ul>
      <Report id={c.id} path={path} />
    </section>
  </article>
</Base>
