---
import Base from "../../layouts/Base.astro";
import Speak from "../../components/Speak.astro";
import EvidenceTable from "../../components/EvidenceTable.astro";
import Sources from "../../components/Sources.astro";
import Report from "../../components/Report.astro";
import HiddenNote from "../../components/HiddenNote.astro";
import {
  isUnverified,
  phrases,
  SITUATIONS,
  SITUATION_LABELS,
  PHRASE_REGISTER_LABELS,
  SITE_NAME,
} from "../../lib/data";

export function getStaticPaths() {
  return SITUATIONS.filter((s) => phrases.some((p) => p.situation === s)).map((situation) => ({
    params: { situation },
    props: { items: phrases.filter((p) => p.situation === situation), situation },
  }));
}

const { items, situation } = Astro.props;
const label = SITUATION_LABELS[situation] ?? situation;
const all = SITUATIONS.filter((s) => phrases.some((p) => p.situation === s));
const hidden = items.filter(isUnverified).length;
const path = `/phrases/${situation}/`;
---

<Base
  title={`${label}の英語フレーズ — ${SITE_NAME}`}
  description={`数学の${label}で使う英語の言い回し ${items.length} 件。${items
    .slice(0, 3)
    .map((p) => p.en)
    .join(" / ")}`}
  noindex={hidden === items.length}
  section="phrases"
>
  <p class="meta"><a href="/phrases/">場面別フレーズ</a></p>
  <h1 class="page-title">{label}</h1>

  <ul class="jump" aria-label="場面">
    {
      all.map((s) => (
        <li>
          <a href={`/phrases/${s}/`} aria-current={s === situation ? "page" : undefined}>
            {SITUATION_LABELS[s] ?? s}
          </a>
        </li>
      ))
    }
  </ul>

  <HiddenNote count={hidden} total={items.length} />

  {
    items.map((p) => (
      <section class="phrase" id={p.id} data-unverified-item={isUnverified(p) ? "" : undefined}>
        <h2>{p.intent}</h2>
        <div class="say">
          <span lang="en">{p.en}</span>
          <Speak text={p.en} />
        </div>
        <p class="meta">
          {p.ja}（{PHRASE_REGISTER_LABELS[p.register] ?? p.register}）
          {isUnverified(p) && <span class="badge unverified">未確認</span>}
        </p>
        {p.variants?.length ? (
          <dl class="pairs">
            {p.variants.map((v) => (
              <>
                <dt lang="en">{v.en}</dt>
                <dd>
                  {PHRASE_REGISTER_LABELS[v.register] ?? v.register}
                  {v.note ? ` — ${v.note}` : ""}
                </dd>
              </>
            ))}
          </dl>
        ) : null}
        {p.notes?.length ? (
          <section class="block">
            <h2>注意</h2>
            <ul class="plain">
              {p.notes.map((n) => (
                <li>{n}</li>
              ))}
            </ul>
          </section>
        ) : null}
        <details>
          <summary>件数と出典</summary>
          <EvidenceTable evidence={p.evidence} unit="key" />
          <section class="block meta">
            <h2>出典</h2>
            <Sources sources={p.sources} />
            <Report id={p.id} path={`${path}#${p.id}`} />
          </section>
        </details>
      </section>
    ))
  }
</Base>
