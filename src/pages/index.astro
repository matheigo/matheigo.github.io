---
import Base from "../layouts/Base.astro";
import MappingFigure from "../components/MappingFigure.astro";
import { conventions, phrases, symbols, terms, SITUATIONS, SITUATION_LABELS, SITE_NAME } from "../lib/data";

const site = Astro.site?.href ?? "https://matheigo.github.io/";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: `${SITE_NAME} 数学の日英辞典`,
  url: site,
  inLanguage: ["ja", "en"],
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: `${site}?q={search_term_string}` },
    "query-input": "required name=search_term_string",
  },
};
const verified = <T extends { confidence: string }>(xs: T[]) => xs.filter((x) => x.confidence === "verified");
const fmt = (n: number) => n.toLocaleString("en-US");
const counts = {
  terms: verified(terms).length,
  symbols: verified(symbols).length,
  phrases: verified(phrases).length,
  conventions: verified(conventions).length,
};
const scenes = SITUATIONS.map((s) => ({ s, n: verified(phrases).filter((p) => p.situation === s).length })).filter((x) => x.n);
const tries = [
  { q: "増減表", en: false },
  { q: "上に凸", en: false },
  { q: "plug in", en: true },
];
---

<Base title={`${SITE_NAME} — 数学の日英辞典（日本語⇄英語）`} jsonLd={jsonLd} home>
  <link slot="head" rel="preload" href="/search-index.json" as="fetch" crossorigin="anonymous" />

  <section class="hero">
    <div class="hero-text">
      <h1>数学は同じ。<br />言葉が違う。</h1>
      <p class="sub" lang="en">The math is the same. The words are not.</p>
      <p>日本で学んだ数学の言葉を、米国の教室で通じる英語に。言い方は、米国の講義の書き起こしと教科書で数えて確かめています。</p>

      <form class="search" role="search" action="/" method="get">
        <label for="q">日本語でも英語でも引けます</label>
        <div class="row">
          <input
            id="q"
            name="q"
            type="search"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="search"
            placeholder="増減表、ぞうげんひょう、sign chart"
          />
          <button type="submit" class="primary">引く</button>
        </div>
        <p class="tries">
          試しに引く
          {
            tries.map((t) => (
              <a href={`/?q=${encodeURIComponent(t.q)}`} data-try={t.q}>
                {t.en ? (
                  <span class="lat" lang="en">
                    {t.q}
                  </span>
                ) : (
                  t.q
                )}
              </a>
            ))
          }
        </p>
      </form>
      <p id="status" class="meta" aria-live="polite"></p>
      <ul class="hits" id="hits" hidden></ul>
    </div>

    <MappingFigure />
  </section>

  <div id="home">
    <section class="home-sec">
      <p class="counts-line">
        確かめ終えたのは、<a href="/terms/">用語 {fmt(counts.terms)} 語</a>、<a href="/symbols/">記号の読み方 {fmt(counts.symbols)}</a>、<a
          href="/phrases/">場面別のフレーズ {fmt(counts.phrases)}</a
        >、<a href="/conventions/">日米の書き方の違い {fmt(counts.conventions)}</a>。どれも、米国の講義と教科書で実際に使われている言い方かを数えてから載せています。
      </p>
    </section>

    <section class="home-sec">
      <h2>場面から引く</h2>
      <ul class="scenes">
        {
          scenes.map((x) => (
            <li>
              <a href={`/phrases/${x.s}/`}>
                <span class="scene-ja">{SITUATION_LABELS[x.s]}</span>
                <span class="n">{x.n}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<script>
  import { createIndexAsync, expand, lookup, type CompactIndex, type SearchDoc } from "../lib/search";
  import { GLOSS_LABEL, GLOSS_SHORT } from "../lib/gloss";

  const KIND: Record<string, string> = { term: "用語", symbol: "記号", phrase: "フレーズ", convention: "慣習差" };

  const input = document.getElementById("q") as HTMLInputElement;
  const hits = document.getElementById("hits") as HTMLUListElement;
  const status = document.getElementById("status") as HTMLParagraphElement;
  const home = document.getElementById("home") as HTMLDivElement;

  let docs: SearchDoc[] | null = null;
  let mini: Awaited<ReturnType<typeof createIndexAsync>> | null = null;

  const escape = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  const row = (r: SearchDoc) => `<li class="hit"><a href="${r.url}">
      <span class="hit-ja">${escape(r.label)}</span>
      <span class="hit-kind">${KIND[r.type] ?? r.type}${r.verified ? "" : ' <span class="badge">未確認</span>'}</span>
      ${r.type === "term" ? `<span class="hit-reading">${escape(r.reading)}</span>` : ""}
      <span class="hit-en" lang="en">${escape(r.hint)}${
        r.gloss ? ` <span class="gloss-short" lang="ja" title="${GLOSS_LABEL}">${GLOSS_SHORT}</span>` : ""
      }</span>
    </a></li>`;

  function run() {
    const q = input.value;
    if (!q.trim()) {
      hits.hidden = true;
      hits.innerHTML = "";
      home.hidden = false;
      status.textContent = "";
      return;
    }
    home.hidden = true;
    if (!docs) {
      status.textContent = "読み込み中…";
      return;
    }
    const all = lookup(docs, mini, q);
    const show = document.documentElement.dataset.unverified === "show";
    const visible = show ? all : all.filter((r) => r.verified);
    const hidden = all.length - visible.length;
    hits.innerHTML = visible.map(row).join("");
    hits.hidden = visible.length === 0;
    status.innerHTML =
      (visible.length ? `${visible.length} 件` : "見つかりませんでした") +
      (hidden ? `（未確認の ${hidden} 件を隠しています <button type="button" data-show-unverified>表示する</button>）` : "");
    document.dispatchEvent(new CustomEvent("matheigo:searched"));
  }

  // The preload in <head> has usually fetched the index by the time this runs.
  fetch("/search-index.json")
    .then((r) => r.json() as Promise<CompactIndex>)
    .then((index) => {
      docs = expand(index);
      document.documentElement.dataset.search = "scan";
      run();
      // The substring scan answers until MiniSearch is ready; build it in chunks off the input path.
      return createIndexAsync(docs).then((built) => {
        mini = built;
        document.documentElement.dataset.search = "ready";
        if (input.value.trim()) run();
      });
    })
    .catch(() => {
      status.textContent = "検索の索引を読み込めませんでした。";
    });

  const remember = () => {
    const url = new URL(location.href);
    if (input.value.trim()) url.searchParams.set("q", input.value);
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);
  };
  let timer = 0;
  input.addEventListener("input", () => {
    run();
    clearTimeout(timer);
    timer = window.setTimeout(remember, 400);
  });
  input.form!.addEventListener("submit", (e) => {
    e.preventDefault();
    const first = hits.querySelector("a");
    if (first) location.href = first.href;
  });
  // 「試しに引く」 fills the box instead of reloading the page.
  document.querySelectorAll<HTMLAnchorElement>("a[data-try]").forEach((a) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      input.value = a.dataset.try ?? "";
      run();
      remember();
      input.focus();
    }),
  );
  document.addEventListener("matheigo:unverified-changed", run);

  const initial = new URLSearchParams(location.search).get("q");
  if (initial) input.value = initial;
  // On a slow connection the user may have typed before this script arrived.
  if (input.value.trim()) run();
  if (location.hash === "#q") input.focus();
</script>
