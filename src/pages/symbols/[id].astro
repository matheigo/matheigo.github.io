---
import Base from "../../layouts/Base.astro";
import Math from "../../components/Math.astro";
import Speak from "../../components/Speak.astro";
import Evidence from "../../components/Evidence.astro";
import Sources from "../../components/Sources.astro";
import Report from "../../components/Report.astro";
import UnverifiedGate from "../../components/UnverifiedGate.astro";
import {
  symbols,
  termById,
  conventionById,
  phraseById,
  symbolById,
  symbolCategory,
  SYMBOL_CATEGORIES,
  isUnverified,
  isExplanatoryTranslation,
  REGISTER_LABELS,
  SITE_NAME,
  levelJp,
  levelUs,
} from "../../lib/data";
import { GLOSS_LABEL, GLOSS_SHORT } from "../../lib/gloss";
import { ogPath } from "../../lib/og";

export function getStaticPaths() {
  return symbols.map((s) => ({ params: { id: s.id }, props: { symbol: s } }));
}

const { symbol: s } = Astro.props;
const unverified = isUnverified(s);
const path = `/symbols/${s.id}/`;
const first = s.spoken_en[0].text;
const title = `${s.name_ja} の英語の読み方 | ${first} — ${SITE_NAME}`;
const description = `${s.name_ja}（${s.name_en}）は英語で「${first}」と読む。${s.notes?.[0] ?? ""}`.trim();
const term = s.term_ref ? termById.get(s.term_ref) : undefined;
const related = (s.related ?? [])
  .map((r) => conventionById.get(r) ?? symbolById.get(r))
  .filter((x) => x !== undefined);
// the phrase that says the symbol in words (Phase 5 監査 6 の決定 11)
const relatedPhrases = (s.related ?? []).map((r) => phraseById.get(r)).filter((x) => x !== undefined);
const category = SYMBOL_CATEGORIES.find(([k]) => k === (symbolCategory.get(s.id) ?? "notation-other"));
const say = s.tts_text ?? first;
const jpLevel = levelJp(s.level);
const usLevel = levelUs(s.level);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: s.name_ja,
  alternateName: s.name_en,
  description: `英語の読み方: ${s.spoken_en.map((x) => x.text).join(" / ")}`,
  inLanguage: "ja",
  url: new URL(path, Astro.site).href,
  inDefinedTermSet: { "@type": "DefinedTermSet", name: "MathEigo 数学の日英辞典", url: Astro.site?.href },
};
---

<Base
  title={title}
  description={description}
  unverified={unverified}
  ogImage={ogPath("symbols", s.id, !unverified)}
  jsonLd={jsonLd}
  section="symbols"
>
  {unverified && <UnverifiedGate kind="記号" />}

  <article class="entry" data-unverified-item={unverified ? "" : undefined}>
    <header class="entry-head">
      {unverified && <p class="unverified-note">この記号はまだ監査を通っていません（未確認）。</p>}
      <p class="crumbs">
        <a href="/symbols/">記号・式の読み上げ</a>
        {category && (
          <>
            {" ／ "}
            <a href={`/symbols/#${category[0]}`}>{category[1]}</a>
          </>
        )}
      </p>
      <h1 class="sym-ja">{s.name_ja}</h1>
      <p class="sym-en" lang="en">{s.name_en}</p>
    </header>

    <div class="entry-body">
      <div class="entry-main">
        <section class="formula">
          <h2>英語ではこう読む</h2>
          <Math latex={s.latex} />
          <ul class="readings">
            {s.spoken_en.map((sp, i) => (
              <li>
                <span class="said">
                  <span lang="en">{sp.text}</span>
                  {i === 0 && <Speak text={say} size="small" name={first} />}
                </span>
                <span class="reg">{REGISTER_LABELS[sp.register] ?? sp.register}</span>
              </li>
            ))}
          </ul>
          {s.respelling && (
            <p class="meta">
              発音 <span class="lat" lang="en">{s.respelling}</span>
            </p>
          )}
          <p class="meta">日本語では　{s.spoken_ja}</p>
        </section>

        {
          s.notes?.length ? (
            <section>
              <h2>注意</h2>
              <ul class="pitfalls">
                {s.notes.map((n) => (
                  <li>
                    {n}
                  </li>
                ))}
              </ul>
            </section>
          ) : null
        }

        <Evidence evidence={s.evidence} lead={first} />
      </div>

      <aside class="entry-aside" aria-label="この記号について">
        <section class="first">
          <h2>習う時期</h2>
          <dl class="when">
            <dt>日本</dt>
            <dd>{jpLevel || "—"}</dd>
            <dt>米国</dt>
            <dd>{usLevel ? <span class="lat" lang="en">{usLevel}</span> : "—"}</dd>
          </dl>
        </section>

        {
          term && (
            <section>
              <h2>用語</h2>
              <ul class="rel">
                <li>
                  <a href={`/terms/${term.id}/`}>
                    <span class="rel-ja">{term.ja.term}</span>
                    <span class="rel-en" lang="en">
                      {term.en.term}
                      {isExplanatoryTranslation(term) && <span class="gloss-short" lang="ja" title={GLOSS_LABEL}>{GLOSS_SHORT}</span>}
                    </span>
                  </a>
                </li>
              </ul>
            </section>
          )
        }

        {
          related.length ? (
            <section>
              <h2>関連する慣習差・記号</h2>
              <ul class="rel">
                {related.map((r) =>
                  "title_ja" in r ? (
                    <li>
                      <a href={`/conventions/${r.id}/`}>
                        <span class="rel-ja">{r.title_ja}</span>
                        <span class="rel-en">日米の慣習差</span>
                      </a>
                    </li>
                  ) : (
                    <li>
                      <a href={`/symbols/${r.id}/`}>
                        <span class="rel-ja">{r.name_ja}</span>
                        <span class="rel-en" lang="en">
                          {r.spoken_en[0].text}
                        </span>
                      </a>
                    </li>
                  ),
                )}
              </ul>
            </section>
          ) : null
        }

        {
          relatedPhrases.length ? (
            <section>
              <h2>言葉で言うとき（フレーズ）</h2>
              <ul class="rel">
                {relatedPhrases.map((p) => (
                  <li>
                    <a href={`/phrases/${p.situation}/#${p.id}`}>
                      <span class="rel-ja">{p.intent}</span>
                      <span class="rel-en" lang="en">
                        {p.en}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ) : null
        }

        <section>
          <h2>出典</h2>
          <Sources sources={s.sources} />
        </section>

        <section class="about-entry">
          <h2>この項目について</h2>
          <p>{s.confidence === "verified" ? "監査済み" : "未確認（監査前）"}。{s.updated && `更新 ${s.updated}。`}</p>
          <Report id={s.id} path={path} />
        </section>
      </aside>
    </div>
  </article>
</Base>
