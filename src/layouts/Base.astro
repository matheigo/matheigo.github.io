---
import "../styles/global.css";
import "katex/dist/katex.min.css";

import { SHOW_UNVERIFIED_BY_DEFAULT } from "../lib/data";

interface Props {
  title: string;
  description?: string;
  /** Set on pages whose content has not passed the audit: adds noindex. */
  unverified?: boolean;
}

const { title, unverified = false, description = "日本で学んだ数学を、米国の教室で言える・書ける・聞き取れるようにする日英辞典。" } = Astro.props;
const nav = [
  { href: "/symbols", label: "記号" },
  { href: "/phrases/office-hours", label: "フレーズ" },
  { href: "/conventions", label: "慣習差" },
  { href: "/curriculum", label: "対応表" },
  { href: "/download", label: "ダウンロード" },
  { href: "/about", label: "このサイト" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {unverified && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline define:vars={{ fallback: SHOW_UNVERIFIED_BY_DEFAULT }}>
      // Runs before paint so unverified rows never flash into view.
      const stored = localStorage.getItem("matheigo:show-unverified");
      const show = stored === null ? fallback : stored === "1";
      document.documentElement.dataset.unverified = show ? "show" : "hide";
    </script>
  </head>
  <body>
    <div class="wrap">
      <header class="masthead">
        <a class="home" href="/">MathEigo</a>
        <nav>
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <label class="toggle">
            <input type="checkbox" id="show-unverified" />
            未確認の語も表示
          </label>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <script is:inline>
        {
          const box = document.getElementById("show-unverified");
          box.checked = document.documentElement.dataset.unverified === "show";
          box.addEventListener("change", () => {
            document.documentElement.dataset.unverified = box.checked ? "show" : "hide";
            localStorage.setItem("matheigo:show-unverified", box.checked ? "1" : "0");
            document.dispatchEvent(new CustomEvent("matheigo:unverified-changed"));
          });
        }
      </script>
      <footer class="site">
        データは CC0 1.0、コードは MIT。誤りを見つけたら <a href="/about">報告</a> してください。
      </footer>
    </div>
  </body>
</html>
