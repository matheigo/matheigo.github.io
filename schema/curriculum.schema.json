{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matheigo.org/schema/curriculum.schema.json",
  "title": "MathEigo curriculum unit",
  "type": "object",
  "properties": {
    "id": { "$ref": "_common.schema.json#/$defs/id" },
    "system": { "enum": ["jp", "us"] },
    "track": {
      "enum": ["traditional", "integrated", "ap", "college"],
      "description": "US only: which of the four US tracks this unit belongs to."
    },
    "subject": { "type": "string", "minLength": 1 },
    "unit": { "type": "string", "minLength": 1 },
    "topics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "us_equivalents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "course": { "type": "string" },
          "coverage": { "enum": ["full", "most", "some", "none"] },
          "note": { "type": "string" }
        },
        "required": ["course", "coverage"],
        "additionalProperties": false
      }
    },
    "jp_equivalents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": { "type": "string" },
          "coverage": { "enum": ["full", "most", "some", "none"] },
          "note": { "type": "string" }
        },
        "required": ["subject", "coverage"],
        "additionalProperties": false
      }
    },
    "term_refs": { "type": "array", "items": { "$ref": "_common.schema.json#/$defs/id" } },
    "sources": { "$ref": "_common.schema.json#/$defs/sources" },
    "updated": { "$ref": "_common.schema.json#/$defs/date" }
  },
  "required": ["id", "system", "subject", "unit", "topics", "term_refs"],
  "additionalProperties": false
}
